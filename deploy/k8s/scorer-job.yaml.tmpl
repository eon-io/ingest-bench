# One scorer observes commits and publish logs through the drain phase,
# uploading artifacts incrementally. Keep a single observer so each commit
# has one visibility timestamp for freshness measurements.
apiVersion: batch/v1
kind: Job
metadata:
  name: __NAME__
  namespace: __NAMESPACE__
  labels:
    lakehouse-ingest-bench: "true"
spec:
  backoffLimit: 0
  completions: 1
  template:
    metadata:
      labels:
        lakehouse-ingest-bench: "true"
    spec:
      restartPolicy: Never
      serviceAccountName: __SERVICE_ACCOUNT__
      nodeSelector: __NODE_SELECTOR__
      tolerations: __TOLERATIONS__
      containers:
        - name: harness
          image: __IMAGE__
          command: __COMMAND__
          env: __ENV__
          envFrom: __ENV_FROM__
          # launch.sh sets SCORER_CPU and SCORER_MEMORY. A commit poll reads one
          # ID column per concurrent reader, and each read process adds another
          # interpreter. Reads release each file after tallying it.
          resources:
            requests:
              cpu: "__CPU__"
              memory: "__MEMORY__"
            limits:
              memory: "__MEMORY__"
          volumeMounts:
            - name: work
              mountPath: /work
      volumes:
        - name: work
          emptyDir: {}
