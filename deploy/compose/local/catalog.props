# Catalog properties for --catalog-prop-file, mounted at /catalog.props.
# A file keeps credentials out of process arguments. Example:
#   create-table --catalog-prop-file /catalog.props --table bench.events …
uri=http://iceberg-rest:8181
warehouse=s3://warehouse/
s3.endpoint=http://minio:9000
s3.access-key-id=admin
s3.secret-access-key=password
s3.path-style-access=true
s3.region=us-east-1
