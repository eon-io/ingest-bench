{
  "name": "events",
  "description": "Synthetic event stream: high-cardinality ids, Zipf categoricals, two decimals, one measure, an incompressible payload.",
  "columns": [
    {"name": "event_time",   "kind": "timestamp",   "role": "event_time", "cardinality": 0},
    {"name": "event_id",     "kind": "categorical", "role": "entity", "width": 32},
    {"name": "event_type",   "kind": "categorical", "cardinality": 6, "alpha": 1.5,
     "vocabulary": ["view", "click", "scroll", "purchase", "error", "heartbeat"]},
    {"name": "user_id",      "kind": "categorical", "cardinality": 1000000, "alpha": 0.9, "vocabulary": ["u"]},
    {"name": "source_id",    "kind": "categorical", "cardinality": 5000,    "alpha": 1.0, "vocabulary": ["src"]},
    {"name": "page_id",      "kind": "categorical", "cardinality": 50000,   "alpha": 0.9, "vocabulary": ["pg"]},
    {"name": "account_id",   "kind": "categorical", "cardinality": 2000,    "alpha": 1.0, "vocabulary": ["acct"]},
    {"name": "campaign_id",  "kind": "categorical", "cardinality": 40000,   "alpha": 0.9, "vocabulary": ["cmp"]},
    {"name": "asset_id",     "kind": "categorical", "cardinality": 200000,  "alpha": 0.8, "vocabulary": ["ast"]},
    {"name": "country",      "kind": "categorical", "cardinality": 40, "alpha": 1.2,
     "vocabulary": ["US", "GB", "DE", "FR", "BR", "IN", "JP", "CA", "AU", "MX",
                    "IT", "ES", "NL", "SE", "PL", "TR", "ID", "KR", "AR", "CO",
                    "ZA", "NG", "EG", "SA", "AE", "SG", "TH", "VN", "PH", "MY",
                    "CL", "PE", "BE", "CH", "AT", "NO", "DK", "FI", "IE", "PT"]},
    {"name": "device_type",  "kind": "categorical", "cardinality": 4, "alpha": 1.0,
     "vocabulary": ["mobile", "desktop", "tablet", "tv"]},
    {"name": "os",           "kind": "categorical", "cardinality": 8, "alpha": 1.0,
     "vocabulary": ["android", "ios", "windows", "macos", "linux", "tvos", "chromeos", "other"]},
    {"name": "browser",      "kind": "categorical", "cardinality": 8, "alpha": 1.2,
     "vocabulary": ["chrome", "safari", "firefox", "edge", "samsung", "opera", "webview", "other"]},
    {"name": "viewport",     "kind": "categorical", "cardinality": 12, "alpha": 1.1,
     "vocabulary": ["300x250", "728x90", "320x50", "160x600", "970x250", "300x600",
                    "336x280", "320x100", "970x90", "468x60", "250x250", "120x600"]},
    {"name": "price",        "kind": "decimal", "cardinality": 5000, "alpha": 0.5, "minimum": 0.01, "maximum": 50.0},
    {"name": "cost",         "kind": "decimal", "cardinality": 5000, "alpha": 0.5, "minimum": 0.0,  "maximum": 50.0},
    {"name": "amount_micros","kind": "integer", "role": "sum_measure", "cardinality": 1000000, "alpha": 0.6, "minimum": 0, "maximum": 5000000},
    {"name": "latency_ms",   "kind": "integer", "cardinality": 5000, "alpha": 0.5, "minimum": 1, "maximum": 5000},
    {"name": "is_visible",   "kind": "boolean", "cardinality": 2, "alpha": 1.0},
    {"name": "client_hash",  "kind": "categorical", "width": 16},
    {"name": "payload",      "kind": "blob", "role": "payload", "cardinality": 20000}
  ]
}
